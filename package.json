{
  "name": "traceflow",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight distributed tracing and observability platform built on OpenTelemetry",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @traceflow/db migrate",
    "db:generate": "pnpm --filter @traceflow/db generate",
    "dev": "concurrently -k -n collector,api,web -c magenta,blue,cyan \"pnpm --filter @traceflow/collector dev\" \"pnpm --filter @traceflow/api dev\" \"pnpm --filter @traceflow/web dev\"",
    "demo:services": "pnpm --filter @traceflow/example-microservices start",
    "demo": "pnpm --filter @traceflow/example-microservices scenarios",
    "demo:traffic": "pnpm --filter @traceflow/example-microservices traffic",
    "build": "pnpm --filter @traceflow/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
